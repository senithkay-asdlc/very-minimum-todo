{
  "version": 3,
  "permissions": [
    {
      "resource": "todos",
      "component": "todo-api",
      "description": "A user's personal todo items",
      "actions": [
        { "handle": "read", "description": "The caller's own todos" },
        { "handle": "create", "description": "Add a new todo" },
        { "handle": "update", "description": "Change a todo's done state" }
      ]
    }
  ],
  "groups": [
    { "name": "Users", "description": "Everyone who signs in to the todo app" }
  ],
  "roles": [
    {
      "name": "User",
      "description": "Signs in, adds todos, and marks them done or not-done.",
      "stories": [1, 2, 3, 4, 5],
      "grants": ["todos:read", "todos:create", "todos:update"],
      "assignTo": ["Users"]
    }
  ],
  "testUsers": [
    { "username": "test-user", "roles": ["User"] },
    { "username": "test-user-2", "roles": ["User"] }
  ]
}
