{
  "name": "todo-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "todo-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    2,
    3,
    4,
    5
  ],
  "description": "Owns the todo entity: create, list, and toggle done/not-done for the signed-in caller's own todos, persisted in a dedicated Postgres database. It does not manage user identity — that is asserted by the gateway from the signed-in caller's token — and it exposes no editing or deletion of todo text.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "todo-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "very-minimum-todo-todo-db",
        "envBindings": {
          "dbname": "TODO_DB_DBNAME",
          "host": "TODO_DB_HOST",
          "password": "TODO_DB_PASSWORD",
          "port": "TODO_DB_PORT",
          "user": "TODO_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "very-minimum-todo-fdf13352",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
